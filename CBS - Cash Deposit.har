            "mimeType": "text/html",
            "compression": 0,
            "text": "<!-- ko if : $component.displayScreen-->  \n  <div id=\"buttonBarTransactionDefinition\" class=\"oj-header-border\" data-bind=\"component: {name:'button-bar-transaction-definition', params:{rootModel:$data,title: rbMenu['4005'],tdefBackButtonRequired: tdefBackButtonReqd}}\"></div>  \n  <div id=\"mainContent\" role=\"main\" class=\"oj-flex oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12 oj-padding-top oj-panel\" style=\"height:70.5vh;overflow:auto\"> \n    <div id=\"mainScreen\" class=\"oj-flex-item oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12\"> \n      <div class=\"oj-flex \"> \n        <div id=\"DenmTCYCode\" class=\"oj-flex-item oj-sm-4 oj-md-4 oj-lg-4 oj-xl-4\" data-bind=\"component: {name:'fc-select', params:{rootModel:$data,tabIndex:'1',id:'DenmTCYCode',isKeyField:false, label:rb4005.ccyCod, isRequired: true, dataPath: 'DenmTCYCode', isDBCall:false, lockedat:[], isDynamic:true, defaultValue:denmCurrency, manualDisable:true, options: 'Currency', rootAttributes: {style:'max-width: 10em'}}}\"></div>  \n        <div id=\"DenmTCYTOTAmount\" class=\"oj-sm-4 oj-md-4 oj-lg-4 oj-xl-4\" data-bind=\"component: {name:'positive-amount', params:{rootModel:$data,id:'DenmTCYAmount',tabIndex:'2',isKeyField:false, label:rb4005.txnAmo, isRequired: false,dataPath: 'TCY_TOT_Amount', lockedat:[],manualDisable:true, modelListenerId:'DenmTCYCode', rootAttributes: {style:'max-width: 13em'}}}\"></div>  \n        <div id=\"DenmTCYAmount\" class=\"oj-sm-4 oj-md-4 oj-lg-4 oj-xl-4\" data-bind=\"visible : false,component: {name:'positive-amount', params:{rootModel:$data,id:'DenmTCYAmount',tabIndex:'2',isKeyField:false, label:rb4005.txnAmo, isRequired: false,dataPath: 'TCY_Amount', lockedat:[],manualDisable:true, modelListenerId:'DenmTCYCode', rootAttributes: {style:'max-width: 13em'}}}\"></div>  \n        <div id=\"DenmTotAmt\" class=\"oj-flex-item oj-sm-4 oj-md-4 oj-lg-4 oj-xl-4\" data-bind=\"component: {name:'positive-amount', params:{rootModel:$data,id:'DenmTotAmt',tabIndex:'3',isKeyField:false, label:rb4005.totAmo, isRequired: false,manualDisable:true,dataPath: 'TotAmt', modelListenerId:'DenmTCYCode', lockedat:[], rootAttributes: {style:'max-width: 13em'}}}\"></div> \n      </div>  \n      <div class=\"oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12 oj-header-border oj-padding-top oj-panel\"> \n        <div class=\"oj-flex \"> \n          <div class=\"oj-flex-item oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12\" id=\"tbDenmDetails\" data-bind=\"component: {name:'fc-datagrid', params:{rootModel:$data, id: 'tbDenmDetails', tabIndex:'4',editMode: editModeDenmGrid, width:widthStyle,datasource: grdSummaryDenmDatasource,onCellEdit: onDoubleClickDenmgrdSummary,pageSize:'20',CellClassName: getCellClassName ,DisablePaging :true, headerTemplate:'4005_header_template',cellTemplate:getCellTemplate, rootAttributes : {'style': 'width: 800px;height:530px'}}}\"></div> \n        </div>  \n        <script type=\"text/html\" id=\"4005_header_template\"> \n          <!-- ko if: ($context.key == 'TXT') -->  \n          <span data-bind=\"text: $parent.rb4005.grdHeaderTemplate[0] \"></span>  \n          <!-- /ko -->  \n          <!-- ko if: ($context.key =='COUNT') -->  \n          <span data-bind=\"text: $parent.rb4005.grdHeaderTemplate[1] \"></span>  \n          <!-- /ko -->  \n          <!-- ko if: $context.key =='UserCount' -->  \n          <span data-bind=\"text: $parent.rb4005.grdHeaderTemplate[2] \"></span>  \n          <!-- /ko -->  \n          <!-- ko if: ($context.key == 'AmtDenm') -->  \n          <span data-bind=\"text: $parent.rb4005.grdHeaderTemplate[3] \"></span>  \n          <!-- /ko --> \n        </script>  \n        <script type=\"text/html\" id=\"4005_cellTemplate\"> \n          <!-- ko if: $context.keys.column == 'TXT' -->  \n          <span data-bind=\"text: $context.data\"></span>  \n          <!-- /ko -->  \n          <!-- ko if: $context.keys.column == 'COUNT' -->  \n          <span data-bind=\"text: $context.data\"></span>  \n          <!-- /ko -->  \n          <!-- ko if: $context.keys.column == 'UserCount' -->  \n          <span data-bind=\"text: $parent.strictNumberFormatter($context.data())\"></span>  \n          <!-- /ko -->  \n          <!-- ko if: $context.keys.column == 'AmtDenm' -->  \n          <span data-bind=\"text:  $parent.amountFormatter(($context.data()),$parent.currencyCode(),$parent.globalData())\"></span>  \n          <!-- /ko -->\n        </script>  \n        <script type=\"text/html\" id=\"4005_editTemplate\"> \n          <!-- ko if: ($context.keys.column == 'UserCount') -->  \n          <div class=\"oj-flex oj-sm-12 oj-md-12 oj-lg-5 oj-xl-12 fcr-mar-1\" data-bind=\"component:{name:'positive-and-negative-number', params:{rootModel:$parent,tabIndex:'5', isRequired:true, id:'Count'+$context.indexes.row, onChange:$parent.br_v_denm_no, dataPath:$context.data, rootAttributes: {style:'max-width: 10em'}}}\"></div>  \n          <!-- /ko -->  \n          <!-- ko if: ($context.keys.column == 'AmtDenm') -->\n          <div class=\"oj-flex oj-sm-12 oj-md-12 oj-lg-5 oj-xl-12 fcr-mar-1\" data-bind=\"component: {name:'amount', params:{rootModel:$parent,id:'TCY_Amount',tabIndex:'6', id:'Amount'+$context.indexes.row, isRequired: true, manualDisable:true, onChange:$parent.br_v_denm_amount, modelListenerId:'DenmTCYCode', dataPath: $context.data, rootAttributes: {style:'max-width: 13em'}}}\"></div>\n          <!-- /ko --> \n        </script> \n      </div>  \n      <div id=\"infoBar\" data-bind=\"component: {name:'info-bar-dummy', params:{rootModel:$data}}\"></div> \n    </div> \n  </div>  \n  <!-- /ko -->"
          },
