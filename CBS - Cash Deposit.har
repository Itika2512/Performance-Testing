            "compression": 0,
            "text": "<div id=\"transaction\">\n    <div role=\"main\" class=\"oj-flex oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12 oj-panel\" style=\"height:89vh;overflow:auto\" data-bind=\"attr: {id: screenMnemonic + 'mainContent'}\">\n        <!--ko if:ejTemplateVisibility()--> \n        <div class=\"oj-flex-item oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12\" data-bind=\"visible: transactionScreenVisibility\" >         \n            <div id=\"buttonBarTransactionEJ\" data-bind=\"component: {name:'button-bar-ej', params:{rootModel:$data,title: screenTitle,  getDataToParent: trnBarData}}\"></div>  \n            <!-- ko if : openEJScreen() -->  \n            <div class=\"buttonBar\"></div>\n            <!--/ko-->\n        </div>\n        <div data-bind=\"attr: {id: 'myModal' + screenMnemonic}\" class=\"modal\">\n            <span class=\"close\" onclick=\"closeImageModal(this);\">&times;</span>\n            <img class=\"modal-content\" data-bind=\"attr: {id: 'img01' + screenMnemonic}\">\n        </div>\n        <div id=\"transactionScreen\" class=\"oj-flex-item oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12\" data-bind=\"visible: openEJScreen,attr: {id: screenMnemonic + 'main'}, component: {name: screenMnemonic, params:{rootModel:$data}}\"></div>  \n        <!-- ko ifnot : openEJScreen() -->  \n        <div id=\"EJChildScreen\" class=\"oj-flex-item oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12\" data-bind=\"visible: transactionScreenVisibility,attr: {id: EJChildScreen + 'main'},component: {name: EJChildScreen, params:{rootModel:$data}}\"></div> \n        <!--/ko-->\n        <!--/ko-->\n        <!--ko if:ChildTxnVisibility()-->\n        <div id=\"childScreen\" class=\"oj-flex-item oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12\" data-bind=\"attr: {id: childMnemonic + 'main'}, component: {name: childMnemonic, params:{rootModel:$data}}\">  \n        </div>        \n        <!--/ko-->\n        <!-- ko if: accessKeyAvailable() -->\n        <div id=\"accessKeyDiv\" class=\"oj-flex-item oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12\" data-bind=\"component : {name: 'fc-access-key', params:{rootModel:$parent, accessKeyChildScreen: accessKeyChildScreen, parentData :parentAccessKeySelf}}, attr: { id: screenMnemonic + 'main' }\">\n        </div>\n        <!--/ko-->\n    </div>\n</div>\n"
          },
