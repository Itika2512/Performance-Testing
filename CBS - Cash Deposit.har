            "text": "<div id=\"buttonBarTrn\" class=\"oj-flex oj-right\">\n    <div class=\"oj-flex oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12 fcr-mar-2\">\n        <div id=\"radiosetBasic\" class=\"fcr-height-16 fcr-mar-1\">\n            <h4 class=\"fcr-font-size fcr-font-weight-600 fcr-font-color-blue\" data-bind=\"text: title\"></h4>        \n        </div>\n        <div id=\"btnTrn\" class=\"oj-flex-item fcr-right-align fcr-height-16 fcr-mar-2\">\n            \n            <span role=\"separator\" aria-orientation=\"vertical\" class=\"oj-toolbar-separator\"></span>            \n            <oj-button type=\"button\" class=\"fc-button\"  \n                   data-bind=\"attr:{ id: screenMnemonic + 'btnOKTDEF'}\" on-oj-action=\"{{TDEFOkClick}}\" disabled=\"{{tdefokButtonDisable}}\">\n                          <span data-bind=\"text:labelbtnOK\"></span>\n            </oj-button>\n            <!--ko if:CloseBtnRequired()-->\n            <oj-button type=\"button\" class=\"fc-button\" \n               data-bind=\"attr:{ id: screenMnemonic + 'btnCloseTDEF'}\" on-oj-action=\"{{buttonClose}}\">\n                          <span data-bind=\"text:labelbtnClose\"></span>\n            </oj-button>\n            <!--/ko-->\n            <!--ko if:ClearBtnRequired()-->\n            <oj-button type=\"button\" class=\"fc-button\" \n                   data-bind=\"attr:{ id: screenMnemonic + 'btnClearTDEF'}\" on-oj-action=\"{{onButtonClear}}\">\n                          <span data-bind=\"text:labelbtnClear\"></span>\n            </oj-button>\n            <!--/ko-->\n             <!--ko if:TDEFBackButtonRequired()-->\n            <oj-button type=\"button\" class=\"fc-button\" \n                   data-bind=\"attr:{ id: screenMnemonic + 'btnBackTDEF'}\" on-oj-action=\"{{tdefBackBtnClick}}\">\n                          <span data-bind=\"text:labelTdefbtnBack\"></span>\n            </oj-button>\n            <!--/ko-->\n        </div>\n    </div>\n</div>\n<div id=\"dialogWrapperTxndefn\">\n    <oj-dialog dialog-title=\"\" style=\"display:none\" \n    \tdata-bind=\"attr:{ id: screenMnemonic + 'modalDialog1'}\" initialVisibility=\"hide\">\n      <div slot=\"header\" class=\"oj-dialog-header oj-helper-clearfix fc-dialog\">\n        <span id=\"dialogTitleIdTxnDefn1\" class=\"oj-dialog-title\"> Oracle FLEXCUBE Confirm </span> \n     </div>\n        <div class=\"oj-dialog-body\" data-bind=\"text: 'do you want to continue?'\">\n        </div>\n        <div class=\"oj-dialog-footer\">\n            <oj-button class=\"fc-button\" data-bind=\"attr:{ id: screenMnemonic + 'okButtonTDEF'}\" on-oj-action=\"{{dialogButtonOk}} \">\n                                        <span data-bind=\"text: 'OK'\"></span>\n            </oj-button>\n            <oj-button class=\"fc-button\" data-bind=\"attr:{ id: screenMnemonic + 'cancelButtonTDEF'}\" on-oj-action= \"{{dialogButtonCancel}}\">\n                                        <span data-bind=\"text: 'Cancel'\"></span>\n            </oj-button>\n        </div>\n    </oj-dialog> \n</div>\n<div id=\"dialogWrapperOkTxndefn\">\n    <oj-dialog dialog-title=\"\" style=\"display:none\" \n    \tdata-bind=\"attr:{ id: screenMnemonic + 'modalDialog1Ok'}\" initialVisibility=\"hide\">\n        <div slot=\"header\" class=\"oj-dialog-header oj-helper-clearfix fc-dialog\">\n        <span id=\"dialogTitleIdTxnDefn2\" class=\"oj-dialog-title\"> Oracle FLEXCUBE Message </span> \n     </div>\n        <div class=\"oj-dialog-body\" data-bind=\"text: errorTextOk\">\n        </div>\n        <div class=\"oj-dialog-footer\">\n            <oj-button class=\"fc-button\" data-bind=\"attr:{ id: screenMnemonic + 'okButtonTDEF1'}\" on-oj-action= \"{{dialogButtonFinalOk}}\">\n                                        <span data-bind=\"text: 'OK'\"></span>\n            </oj-button>\n        </div>\n    </oj-dialog> \n    </div> \n<oj-dialog dialog-title=\"\" style=\"display:none\" \n\tdata-bind=\"attr:{ id:screenMnemonic+'userManual'}\" initialVisibility=\"hide\"