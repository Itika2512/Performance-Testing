            "size": 20016,
            "mimeType": "text/html",
            "compression": 0,
            "text": "<div id=\"buttonBarTrnEJ\" class=\"oj-flex oj-right\">\n    <div class=\"oj-flex oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12 fcr-mar-2\">\n        <div id=\"radiosetBasic\" class=\"fcr-height-16 fcr-mar-1\">\n            <h4 class=\"fcr-font-size fcr-font-weight-600 fcr-font-color-blue\" data-bind=\"text: title\"></h4>        \n        </div>\n        <div id=\"btnTrnEJ\" class=\"oj-flex-item fcr-right-align fcr-height-16 fcr-mar-2\">\n            <!--            <div class=\"oj-flex-item fcr-height-parent\" data-bind=\"ojComponent: {component: 'ojButtonset',  checked: currentTrnMode, optionChange: buttonClick}\">\n                  ko foreach: trnBar \n                  ko if : !disable() \n                 <label data-bind=\"attr: {for: $parent.screenMnemonic + id}\"></label>\n                 <input type=\"radio\"\n                        data-bind=\"value: trnValue, attr: {id: $parent.screenMnemonic + id, name: $parent.screenMnemonic + 'TrnBar'}, \n                               ojComponent: { component: 'ojButton', label: label, disabled: disable}\"/>\n                  /ko \n                  /ko \n             </div>\n             <span role=\"separator\" aria-orientation=\"vertical\" class=\"oj-toolbar-separator\"></span>-->\n            <!-- ko if : linkTrainVisibility() -->\n             <oj-train\n                      class=\"oj-train-stretch oj-flex-item fcr-right-align fcr-height-16 fcr-mar-10\" \n                      style=\"max-width:400px;margin-left:auto;margin-right:auto;\"\n             selected-step=\"{{currentStepValue}}\"\n             on-selected-step-changed=\"{{onSelect}}\"\n             steps=\"[[stepArray]]\">\n                </oj-train>\n            <!--/ko -->\n            <!-- ko if : EJButtonsVisibility() -->\n                <oj-button type=\"button\" class=\"fc-button\" data-bind=\"visible: btnMarkVisible, attr:{ id: screenMnemonic + 'btnMark'}\" on-oj-action=\"{{showAuthView}}\" disabled=\"{{disableBtnMark}}\">\n                      <span data-bind=\"text:markBtnLbl\"></span>\n            </oj-button>\n            <oj-button type=\"button\" class=\"fc-button\" data-bind=\"visible: btnUnMarkVisible, attr:{ id: screenMnemonic + 'btnUnMark'}\" on-oj-action=\"{{showAuthView}}\" disabled=\"{{disableBtnUnMark}}\">\n                      <span data-bind=\"text:unMarkBtnLbl\"></span>\n            </oj-button>\n            <oj-button type=\"button\" class=\"fc-button\" data-bind=\"visible: btnGrantVisible, attr:{ id: screenMnemonic + 'btnGrant'}\" on-oj-action=\"{{showGrant}}\" disabled=\"{{disableBtnGrant}}\">\n                      <span data-bind=\"text:grantBtnLbl\"></span>\n            </oj-button>\n            <oj-button type=\"button\" class=\"fc-button\" data-bind=\"visible: btnDenyVisible, attr:{ id: screenMnemonic + 'btnDeny'}\" on-oj-action=\"{{showDeny}}\" disabled=\"{{disableBtnDeny}}\">\n                      <span data-bind=\"text:denyBtnLbl\"></span>\n            </oj-button>\n            <oj-button type=\"button\" class=\"fc-button\" data-bind=\"visible: btnPrevVisible, attr:{ id: screenMnemonic + 'btnPrev'}\" on-oj-action=\"{{showPrevious}}\" disabled=\"{{disablePreviousBtn}}\">\n                      <span data-bind=\"text:prevBtnLbl\"></span>\n            </oj-button>\n            <oj-button type=\"button\" class=\"fc-button\" data-bind=\"visible: btnNextVisible, attr:{ id: screenMnemonic + 'btnNext'}\" on-oj-action=\"{{showNext}}\" disabled=\"{{disableNextBtn}}\">\n                      <span data-bind=\"text:nextBtnLbl\"></span>\n            </oj-button>\n            <oj-button type=\"button\" class=\"fc-button\" data-bind=\"visible: btnSubmitVisible, attr:{ id: screenMnemonic + 'btnSubmit'}\" on-oj-action=\"{{showSubmit}}\" disabled=\"{{disableBtnSubmit}}\">\n                      <span data-bind=\"text:submitBtnLbl\"></span>\n            </oj-button>\n            <oj-button type=\"button\" class=\"fc-button\" data-bind=\"visible: btnRecallVisible, attr:{ id: screenMnemonic + 'btnRecall'}\" on-oj-action=\"{{showRecall}}\" disabled=\"{{disableBtnRecall}}\">\n                      <span data-bind=\"text:recallBtnLbl\"></span>\n            </oj-button>            \n            <oj-button type=\"button\" class=\"fc-button\" data-bind=\"visible: btnReversalVisible, attr:{ id: screenMnemonic + 'btnReversal'}\" on-oj-action=\"{{showReversal}}\" disabled=\"{{disableBtnReversal}}\">\n                      <span data-bind=\"text:reverseBtnLbl\"></span>\n            </oj-button>\n            <oj-button type=\"button\" class=\"fc-button\" data-bind=\"visible: btnViewVisible, attr:{ id: screenMnemonic + 'btnView'}\" on-oj-action=\"{{showAuthView}}\" disabled=\"{{disableBtnView}}\">\n                      <span data-bind=\"text:viewBtnLbl\"></span>\n            </oj-button> \n            <oj-button type=\"button\" class=\"fc-button\" data-bind=\"visible: btnBackVisible, attr:{ id: screenMnemonic + 'btnBack'}\" on-oj-action=\"{{showBack}}\" disabled=\"{{disableBtnBack}}\">\n                      <span data-bind=\"text:backBtnLbl\"></span>\n            </oj-button>\n            <oj-button type=\"button\" class=\"fc-button\" data-bind=\"visible: btnResubmitVisible, attr:{ id: screenMnemonic + 'btnResubmit'}\" on-oj-action=\"{{showAuthView}}\" disabled=\"{{disableBtnResubmit}}\">\n                      <span data-bind=\"text:reSubBtnLbl\"></span>\n            </oj-button>\n            <oj-button type=\"button\" class=\"fc-button\" data-bind=\"visible: btnTCDVisible, attr:{ id: screenMnemonic + 'btnTCD'}\" on-oj-action=\"{{showAuthView}}\" disabled=\"{{disableBtnTCD}}\">\n                      <span data-bind=\"text:tcdBtnLbl\"></span>\n            </oj-button>\n            <span role=\"separator\" aria-orientation=\"vertical\" style=\"margin-left:0.5em;\" class=\"oj-toolbar-separator\"></span>\n            <!--/ko -->\n            <!-- ko if : openTDEFButton() --> \n            <div class=\"oj-flex fcr-height-parent fcr-right-align\">\n                <oj-menu-button class=\"fc-button\" data-bind=\"attr: {id: $parent.screenMnemonic + 'DisabledTdef', name: $parent.screenMnemonic + 'DisabledTdef'}\" \n                           chroming=\"half\"\n                           display=\"all\"\n                           label=\"More\"\n                           rootAttributes=\"style:'height: 100% !important\">\n\t\t\t\t<span slot=\"startIcon\" class=\"oj-web-applayout-offcanvas-icon\" ></span>\n\t\t\t\t<oj-menu id=\"menu1\"  class =\"oj-menu-item\" data-bind=\"attr:{id: $parent.screenMnemonic + 'menu1' }\" slot=\"menu\" style=\"width: inherit;min-width: 0em\">      \n                    <!-- ko foreach: trnBar -->\n                    <!-- ko if : !disable() -->\n                        <oj-option> <span id=\"\" data-bind=\"click: $parent.buttonClick, value: dataPath, text: label\"> </span> </oj-option>\n                    <!--/ko -->\n                    <!--/ko  -->\n                </oj-menu>\n            </oj-menu-button>\n            </div>\n            <!--/ko -->\n            <span role=\"separator\" aria-orientation=\"vertical\" class=\"oj-toolbar-separator\"></span>\n<!--            <input type=\"button\" class=\"fc-button\"\n                   data-bind=\"attr:{ id: screenMnemonic + 'UDF'}, \n                      ojComponent: {component: 'ojButton', label: udfBtn, disabled: udfBtnDisable}\"/>-->\n <oj-button type=\"button\" class=\"fc-button\"\n                   data-bind=\"attr:{ id: screenMnemonic + 'btnOK'}\" on-oj-action=\"{{sendRequest}}\" disabled=\"{{disableFetchButton}}\">\n                      <span data-bind=\"text: labelbtnOK\"></span>\n            </oj-button>\n            <oj-button type=\"button\" class=\"fc-button\"\n                   data-bind=\"attr:{ id: screenMnemonic + 'btnCloseEJ'}\" on-oj-action=\"{{buttonClose}}\" disabled=\"{{disableFetchButton}}\">\n                      <span data-bind=\"text: labelbtnClose\"></span>\n            </oj-button> \n            <oj-button type=\"button\" class=\"fc-button\"\n                   data-bind=\"attr:{ id: screenMnemonic + 'btnClearEJ'}\" on-oj-action=\"{{clearScreen}}\" disabled=\"{{disableFetchButton}}\">\n                      <span data-bind=\"text: labelbtnClear\"></span>\n            </oj-button>\n        </div>\n    </div>\n    <!--    <div class=\"oj-flex fcr-mar-1 fcr-height-16\">\n            <div class=\"oj-flex oj-flex-item fcr-height-parent\" data-bind=\"ojComponent: {component: 'ojButtonset',  checked: currentTrnMode, optionChange: buttonClick}\">\n                 ko foreach: trnBar \n                 ko if : !disable() \n                <label data-bind=\"attr: {for: $parent.screenMnemonic + id}\"></label>\n                <input type=\"radio\"\n                       data-bind=\"value: trnValue, attr: {id: $parent.screenMnemonic + id, name: $parent.screenMnemonic + 'TrnBar'}, \n                                  ojComponent: { component: 'ojButton', label: label, disabled: disable}\"/>\n                 /ko \n                 /ko \n            </div>\n                    <span role=\"separator\" aria-orientation=\"vertical\" class=\"oj-toolbar-separator\"></span>\n                    <div class=\"oj-flex fcr-height-parent fcr-right-align\">\n                        <button data-bind=\"attr: {id: $parent.screenMnemonic + 'DisabledTdef', name: $parent.screenMnemonic + 'DisabledTdef'}, \n                                          ojComponent: { component: 'ojButton', display: 'all', menu: '#' + $parent.screenMnemonic + 'menu1', label: 'More', rootAttributes: {style:'height: 100% !important'}}\">\n                        </button>\n                        <ul data-bind=\"attr:{id: $parent.screenMnemonic + 'menu1' }, ojComponent: {component: 'ojMenu', rootAttributes: {style: 'min-width: 0em, width: inherit'}}\" style=\"display:none;\">  class=\"oj-menu-layer oj-focus-within\" \n                             ko foreach: trnBar \n                             ko if : disable() \n   