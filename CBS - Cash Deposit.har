            "text": "<div class=\"oj-flex\">\n    <!--ko if:label -->\n    <div class=\"oj-sm-12 oj-md-4 oj-lg-5 oj-xl-4 oj-flex-item fc-time-box\">\n        <oj-label class=\"fc-left\" for= \"{{idTag}}\"><span data-bind=\"text:label,css:requiredField\"></span>\n    </oj-label>\n    </div>\n    <div class=\"oj-sm-12 oj-md-8 oj-lg-7 oj-xl-8 oj-flex-item timeBox\" style=\"max-width: 7em;\n    margin-bottom: 4px;\">\n        <div class =\"fc-inline-comp disable_check\" data-bind=\"component: {name:'fc-time-box', params:{rootModel:$data,id:idTag + 'time',tabIndex: tabIndexTime,manualDisable: keyField, isRequired: isRequired, onChange: onChange,dataPath: dataPath1, lockedat:[]}}\"></div>\n        <span>:</span>  \n        <div class =\"fc-inline-comp disable_check \" data-bind=\"component: {name:'fc-minute-box', params:{rootModel:$data,id:idTag + 'min',tabIndex: tabIndexMin,manualDisable: keyField, isRequired: isRequired, onChange: onChange,dataPath: dataPath2, lockedat:[]}}\"></div>\n       <!--ko ifnot:isSecHidden -->\n        <span>:</span>\n        <div class =\"fc-inline-comp disable_check\" data-bind=\"component: {name:'fc-second-box', params:{rootModel:$data,id:idTag + 'sec',tabIndex: tabIndexSec,manualDisable: keyField, isRequired: isRequired, onChange: onChange,dataPath: dataPath3, lockedat:[]}}\"></div>  \n        <!-- /ko -->\n        <!-- ko template:{nodes: $componentTemplateNodes} -->\n        <!-- /ko -->\n    </div>\n    <!-- /ko -->\n    <!--ko ifnot:label -->\n    <div class=\"oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12 oj-flex-item timeBox\">\n        <div class =\"fc-inline-comp disable_check \" data-bind=\"component: {name:'fc-time-box', params:{rootModel:$data,id:idTag + 'time',tabIndex: tabIndexTime,manualDisable: keyField, isRequired: isRequired, onChange: onChange,dataPath: dataPath1, lockedat:[]}}\"></div>\n        <span>:</span>\n        <div class =\"fc-inline-comp disable_check\" data-bind=\"component: {name:'fc-minute-box', params:{rootModel:$data,id:idTag + 'min',tabIndex: tabIndexMin,manualDisable: keyField, isRequired: isRequired, onChange: onChange,dataPath: dataPath2, lockedat:[]}}\"></div>\n        <span>:</span>\n        <div class =\"fc-inline-comp disable_check\" data-bind=\"component: {name:'fc-second-box', params:{rootModel:$data,id:idTag + 'sec',tabIndex: tabIndexSec,manualDisable: keyField, isRequired: isRequired, onChange: onChange,dataPath: dataPath3, lockedat:[]}}\"></div> \n        <!-- ko template:{nodes: $componentTemplateNodes} -->\n        <!-- /ko -->\n    </div>\n    <!-- /ko -->\n</div>\n"
          },
