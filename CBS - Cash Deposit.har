            "text": "<div class=\"oj-flex\">\n    <!--ko if:label -->\n    <div class=\"oj-sm-12 oj-md-4 oj-lg-4 oj-xl-4 oj-flex-item\">\n         <oj-label class=\"fc-left\" for= \"{{idTag}}\"><span data-bind=\"text:label,css:requiredField\"></span>\n    </oj-label>\n    </div>\n     <oj-radioset class=\"oj-sm-12 oj-md-8 oj-lg-8 oj-xl-8 oj-flex-item oj-choice-direction-row\" data-bind=\"attr:{id: idTag, name: idTag},event : {blur : blankValidation ,focus : onFocus}\"\nhelp.instruction = \"{{title}}\"\nrequired =false \ndisabled =\"{{keyField}}\" \nrootAttributes=\"{{attributes}}\" \non-value-changed=\"{{onChange}}\" \nvalue= \"{{dataPath}}\">\n         <!-- ko foreach: radioItems -->\n         \n          <oj-option  value=\"{{itemValue}}\" disabled=\"{{disableItem}}\" data-bind=\"event : {blur : $parent.blankValidation ,focus : $parent.onFocus}\">\n       \n          </oj-option>\n         <span data-bind=\"text:itemLabel,attr:{class: itemClass}\"> </span>\n            <!-- /ko -->\n              </oj-radioset>\n        <!-- ko template:{nodes: $componentTemplateNodes} -->\n        <!-- /ko -->\n    \n    <!-- /ko -->\n    <!--ko ifnot:label -->\n    <oj-radioset class=\"oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12 oj-flex-item oj-choice-direction-row\" data-bind=\"attr:{id: idTag, name: idTag},event : {blur : blankValidation ,focus : onFocus}\"\nhelp.instruction = \"{{title}}\"\nrequired =false \ndisabled =\"{{keyField}}\" \nrootAttributes=\"{{attributes}}\" \non-value-changed=\"{{onChange}}\" \nvalue= \"{{dataPath}}\">\n         <!-- ko foreach: radioItems -->\n         \n          <oj-option value=\"{{itemValue}}\" disabled=\"{{disableItem}}\" data-bind=\"event : {blur : $parent.blankValidation ,focus : $parent.onFocus}\">\n       \n          </oj-option>\n         <span data-bind=\"text:itemLabel,attr:{class: itemClass}\"> </span>\n            <!-- /ko -->\n            </oj-radioset>\n    <!-- /ko -->\n</div>\n"
