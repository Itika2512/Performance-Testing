            "text": "    <div>\n        <!-- ko if: fcTabsVisibility() -->\n        <oj-conveyor-belt id=\"conveyor\">\n        <oj-tab-bar  edge=\"top\"\n                     data-bind=\"attr: { id: idTag, name: idTag }\"\n                     class=\"oj-divider-bottom oj-sm-condense\"\n                     data=\"[[tabItemsProvider]]\"\n                     selection=\"[[selectedTab]]\"\n                     on-selection-changed=\"[[onTabChanged]]\"\n                     reorderable=\"disabled\"\n                     orientation=\"horizontal\">\n            <template slot=\"itemTemplate\" data-oj-as=\"item\">\n                <li data-bind=\"attr: {'aria-disabled': isTabDisabled(item.data.tabId) ? 'true' : 'false' }, css: { 'oj-disabled': isTabDisabled(item.data.tabId) }\">\n                    <a href=\"#\">\n                        <oj-bind-text value=\"[[item.data.tabLabel]]\"></oj-bind-text>\n                    </a>\n                </li>\n            </template>\n        </oj-tab-bar>\n        </oj-conveyor-belt>\n\n        <!-- tab contents -->\n\n    <!-- ko foreach: tabItems -->\n        <div class=\"\" data-bind=\"template: { name: tabTemplate , data: $parent }, attr: { id: tabId },visible: $parent.selectedTab()=== tabId\">\n    </div>\n    <!-- /ko -->\n    <!-- /ko -->   \n</div>"
          },
