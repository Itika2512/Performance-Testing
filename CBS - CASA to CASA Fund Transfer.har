            "text": "<div id=\"accessKey\">\n  <!--ko if:accessKeyVisibility()--> \n  <div id=\"accessKeyButtonBar\" class=\"oj-header-border\" data-bind=\"component: {name:'button-bar-access-key', params:{rootModel:$data,title: rbMenu[screenMnemonic]}}\"></div>  \n  <div id=\"accessKeyChildScreen\" class=\"oj-flex-item oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12\" data-bind=\"attr: {id: accessKeyChildMnemonic + 'main'}, component: {name: accessKeyChildMnemonic, params:{rootModel:$data}}\">\n  </div>\n  <div data-bind=\"attr: {id: 'myModal' + screenMnemonic}\" class=\"modal\">\n      <span class=\"close\" onclick=\"closeImageModal(this);\">&times;</span>\n      <img class=\"modal-content\" data-bind=\"attr: {id: 'img01' + screenMnemonic}\">\n  </div>\n  <!--/ko-->\n</div>\n"
