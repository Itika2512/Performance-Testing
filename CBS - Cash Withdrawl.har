            "text": "<div class=\"oj-flex\">\n    <!--ko if:label -->\n    <div class=\"oj-sm-12 oj-md-4 oj-lg-5 oj-xl-4 oj-flex-item\">\n          <oj-label class=\"fc-left\" for= \"{{idTag}}\"><span data-bind=\"text:label,css:requiredField\"></span>\n    </oj-label>\n    </div>\n    <div class=\"oj-sm-12 oj-md-8 oj-lg-7 oj-xl-8 oj-flex-item\">\n        <div>\n            <oj-input-text class=\"fcr-height-parent custom_input_time\" placeholder=\"- -\" type=\"time\"\n    data-bind=\"attr:{id: idTag, name: idTag ,style : styleAlign,maxlength:screenMaxLength},event : {blur : blankValidation ,focus : onFocus}\"\nhelp.instruction = \"{{title}}\"\nrequired =false \ndisabled =\"{{keyField}}\" \nrootAttributes=\"{{attributes}}\" \non-value-changed=\"{{onChange}}\" \nvalue= \"{{dataPath}}\">\n</oj-input-text>\n        </div>\n        <!-- ko template:{nodes: $componentTemplateNodes} -->\n        <!-- /ko -->\n    </div>\n    <!-- /ko -->\n    <!--ko ifnot:label -->\n    <div class=\"oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12 oj-flex-item\">\n            <oj-input-text class=\"fcr-height-parent custom_input_time\" placeholder=\"- -\" type=\"time\"\n    data-bind=\"attr:{id: idTag, name: idTag ,style : styleAlign,maxlength:screenMaxLength},event : {blur : blankValidation ,focus : onFocus}\"\nhelp.instruction = \"{{title}}\"\nrequired =false \ndisabled =\"{{keyField}}\" \nrootAttributes=\"{{attributes}}\" \non-value-changed=\"{{onChange}}\" \nvalue= \"{{dataPath}}\">\n</oj-input-text>\n        <!-- ko template:{nodes: $componentTemplateNodes} -->\n        <!-- /ko -->\n    </div>\n    <!-- /ko -->\n</div>\n"
