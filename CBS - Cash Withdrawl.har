            "text": "<!-- ko if : $component.displayScreen-->\r\n<div id=\"mainContent\" role=\"main\" class=\"mainContent oj-panel\" style=\"\">\r\n\t<div id=\"mainScreen\" class=\"\">\r\n\t\t<div class=\"oj-flex \">\r\n\t\t\t<div id=\"UserName6006\" class=\"oj-flex-item oj-sm-12 oj-md-6 oj-lg-6 oj-xl-6\"\r\n\t\t\t\tdata-bind=\"component: {name:'user-id', params:{rootModel:$data,tabIndex:'1',id:'UserName',isKeyField:false, label:rb6006.telId, isRequired: false, onChange:fetchPostingDate,manualDisable: true,dataPath: 'UserID',lovBinding:'lovReversal',  lockedat:[], rootAttributes: {style:'max-width: 10em'}}}\">\r\n\t\t\t\t<div id=\"lovReversal6006\" class=\"fc-list-btnLov\"\r\n\t\t\t\t\tdata-bind=\"component: {name:'fc-list-of-values',       params:{rootModel:$data,tabIndex:'2',        queryId: 'QRY6006_1' ,  execute:'executeBranchQuery',       columnNames:['UserID','UserName','BranchCode','TxnUserNo'], lovObjListener:['UserName'], columnTexts:rb6006.lovRevCol, rowKeyValue:['UserID'], outputParam: [['UserID'],['UserName'],['BranchCode'],['TxnUserNo']],       inputParam: [['BranchCode','screenBranchInfo','BranchCode'],['UserNo','screenUserInfo','UserNo']],manualDisable: disableReversalLov,       id:'lovReversal',        rootAttributes: {style:'max-width: 10em'}}}\">\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t\t<div class=\"oj-flex \">\r\n\t\t\t<div id=\"options26006\" class=\"oj-flex-item oj-sm-12 oj-md-2 oj-lg-2 oj-xl-2\"></div>\r\n\t\t\t<div id=\"options6006\" class=\"oj-flex-item oj-sm-12 oj-md-10 oj-lg-10 oj-xl-10\"\r\n\t\t\t\tdata-bind=\"component: {name:'radio-set-inline', params:{rootModel:$data,tabIndex:'3',id:'options',isKeyField:false, isRequired: false,manualDisable: disableOptions, onChange:setOptions,radioItems: radioSetOptions, dataPath:'Options', lockedat:[], rootAttributes: {style:'max-width: 10em'}}}\">\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t\t<div class=\"oj-flex \">\r\n\t\t\t<div id=\"PostingDate6006\" class=\"oj-flex-item oj-sm-12 oj-md-6 oj