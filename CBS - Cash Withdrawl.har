            "compression": 0,
            "text": "<div id=\"buttonBarAccessKey\" class=\"oj-flex oj-right\">\n  <div class=\"oj-flex oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12 fcr-mar-2\">\n    <div id=\"radiosetBasic\" class=\"fcr-height-16 fcr-mar-1\">\n      <h4 class=\"fcr-font-size fcr-font-weight-600 fcr-font-color-blue\" data-bind=\"text: title\"></h4>        \n    </div>\n    <div id=\"btnBarAccessKey\" class=\"oj-flex-item fcr-right-align fcr-height-16 fcr-mar-2\">\n\n      <span role=\"separator\" aria-orientation=\"vertical\" class=\"oj-toolbar-separator\"></span>            \n      <oj-button type=\"button\" class=\"fc-button\"  \n                 data-bind=\"attr:{ id: screenMnemonic + 'btnOKAccessKey'}\" on-oj-action=\"{{AccessKeyOkClick}}\">\n        <span data-bind=\"text:labelbtnOK\"></span>\n      </oj-button>\n    </div>\n  </div>\n</div>\n<div id=\"dialogWrapperMemo\">\n  <oj-dialog dialog-title=\"\" style=\"display:none; width: 450px\" \n  \t\tdata-bind=\"attr:{ id: screenMnemonic + 'modalDialogMemo'}\" initialVisibility=\"hide\">\n    <div slot=\"header\" class=\"oj-dialog-header oj-helper-clearfix fc-dialog\">\n      <span id=\"dialogTitleId\" class=\"oj-dialog-title\"> Oracle FLEXCUBE Memo Message </span> \n    </div>\n    <div class=\"oj-dialog-body\" data-bind=\"html: memoTextMessage\">\n    </div>\n    <div class=\"oj-dialog-footer\">\n      <oj-button class=\"fc-button\" data-bind=\"attr:{ id: screenMnemonic + 'okMemoButton'}\" on-oj-action=\"{{dialogButtonMemoOk}} \">\n        <span data-bind=\"text: 'OK'\"></span>\n      </oj-button>\n    </div>\n  </oj-dialog> \n</div>\n<div id=\"dialogWrapperOk\">\n    <oj-dialog dialog-title=\"\" style=\"display:none\" \n    \tdata-bind=\"attr:{ id: screenMnemonic + 'modalDialog1Ok'}\" initialVisibility=\"hide\">\n        <div slot=\"header\" class=\"oj-dialog-header oj-helper-clearfix fc-dialog\">\n        <span id=\"dialogTitleId\" class=\"oj-dialog-title\"> Oracle FLEXCUBE Message </span> \n     </div>\n        <div class=\"oj-dialog-body\" data-bind=\"html: errorTextOk\">\n        </div>\n        <div class=\"oj-dialog-footer\">\n           <oj-button class=\"fc-button\" data-bind=\"attr:{ id: screenMnemonic + 'okButton'}\" on-oj-action=\"{{dialogButtonFinalOk}} \">\n                                    <span data-bind=\"text: 'OK'\"></span>\n            </oj-button>\n        </div>\n    </oj-dialog> \n</div>"
