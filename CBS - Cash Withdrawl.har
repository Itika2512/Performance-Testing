            "text": "<div id=\"dialogWrapperAuth\">\n    <oj-dialog dialog-title=\"\" style=\"display:none; width:1px; min-width:50%;min-height: fit-content;\" data-bind=\"attr:{ id: screenMnemonic + 'authDialog'}\" initialVisibility=\"hide\" resizeBehavior=\"none\" modality=\"modal\" on-oj-close=\"[[onAuthDialogClose]]\">\n        <div slot=\"header\" class=\"oj-dialog-header oj-helper-clearfix fc-dialog\">\n            <span id=\"dialogTitleIdAuth\" class=\"oj-dialog-title\"> Oracle FLEXCUBE Authorization </span> \n        </div>\n        <div class=\"oj-dialog-body\" style=\"height: auto\">\n            <div class=\"oj-flex-item oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12\" id=\"grdAuth\" data-bind=\"component: {name:'fc-datagrid',  \n                        params:{rootModel:$data, id: 'grdAuth',editMode: 'none',width:'width:100%;',datasource: grdAuth,  DisablePaging :true,    \n                        pageSize:'4',CellClassName: 'oj-helper-justify-content-left' ,\n                        headerTemplate:'rowTemplateAuth',cellTemplate:'cellTemplateAuth',rootAttributes:{'style': 'width: 100%;height:150px;'}}}\"></div> \n            <script type=\"text/html\" id=\"rowTemplateAuth\"> \n                <!-- ko if: ($context.key == 'AuthorizationReasons') -->  \n                <span data-bind=\"text: 'Authorization Reasons' \"></span>  \n                <!-- /ko -->  \n                </script>\n                <script type=\"text/html\" id=\"cellTemplateAuth\"> \n                    <!-- ko if: $context.keys.column == 'AuthorizationReasons' -->  \n                    <span data-bind=\"text: $context.data\"></span>  \n                    <!-- /ko -->  \n                    </script>\n                   <!-- ko if : authDetail()-->   \n                   <div class=\"oj-flex-item oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12\" id=\"grdAuthDetails\" data-bind=\"component: {name:'fc-datagrid',  \n                        params:{rootModel:$data, id: 'grdAuthDetails',editMode: 'none',width:'width:100%;',datasource: grdAuthDetails,  DisablePaging :true,    \n                        pageSize:'5',CellClassName: 'oj-helper-justify-content-left' ,\n                        headerTemplate:'rowTemplateAuthDetails',cellTemplate:'cellTemplateAuthDetails',rootAttributes:{'style': 'width: 100%;height:150px;'}}}\"></div> \n                   <script type=\"text/html\" id=\"rowTemplateAuthDetails\"> \n                <!-- ko if: ($context.key == 'Details') -->  \n                <span data-bind=\"text: 'Details' \"></span>  \n                <!-- /ko -->  \n                </script>\n                <script type=\"text/html\" id=\"cellTemplateAuthDetails\"> \n                    <!-- ko if: $context.keys.column == 'Details' -->  \n                    <span data-bind=\"text: $context.data\"></span>  \n                    <!-- /ko -->  \n                    </script>\n                    <!-- /ko -->  \n                    <div class=\"oj-flex \">\n                        <div id=\"divOrgAadhaarNo\" class=\"oj-flex-item oj-sm-12 oj-md-6 oj-lg-6 oj-xl-6\" data-bind=\"visible:showdivOrgAadhaarNo, component: {name:'aadhaar-number', params:{rootModel:$data,id:'divOrgAadhaarNo', dataPath: 'OrgAadhaarNo', label:'Aadhaar Number :', isRequired: true, manualDisable:disableOrgAadhaarNo, lockedat:[], rootAttributes: {style:'max-width: 10em'}}}\"></div>\n                        <div id=\"divAadhaarToken\" class=\"oj-flex-item oj-sm-12 oj-md-6 oj-lg-6 oj-xl-6\" data-bind=\"visible:showdivAadhaarToken, component: {name:'aadhaar-number', params:{rootModel:$data,id:'divAadhaarToken',dataPath: 'AadhaarToken' ,label:'Aadhaar Reference :', isRequired: true, manualDisable:disableDivAadhaarToken,lockedat:[], rootAttributes: {style:'max-width: 10em'}}}\"></div>\n                    </div>\n                      <!-- ko if : authType()-->  \n                    <div class=\"oj-flex \"> \n                        <div id=\"IsLocalOrRemote\" class= \"oj-flex-item oj-sm-12 oj-md-6 oj-lg-6 oj-xl-6\" data-bind=\"component: {name:'radio-set-inline',\n                      params:{rootModel:$data,id:'IsLocalOrRemote', defaultValue: '1',dataPath : 'IsLocalOrRemote',radioItems: radioItemsAuth, onChange: onChangeRadio,manualDisable: true,\n                  rootAttributes: {style:'max-width: 10em'}}}\">\n                        </div>\n                    </div>\n                       <!-- /ko -->  \n                    <!-- ko if : local()-->  \n                    <div class=\"oj-flex\">\n                        <div id=\"supervisorId\" class =\"oj-flex-item oj-sm-12 oj-md-6 oj-lg-6 oj-xl-6\" data-bind=\"component: \n                {name:'login-user-id',params:{rootModel:$data,id:'supervisorId',label:'Supervisor ID:',dataPath: 'authUserId',formatter:'Uppercase', \n                        rootAttributes: {style:'max-width:10em'}}}\">\n                        </div>\n                    </div>\n                    <div class=\"oj-flex\">\n                        <div id=\"primaryPasword\" class =\"oj-flex-item oj-sm-12 oj-md-6 oj-lg-6 oj-xl-6\" data-bind=\"component:\n                {name:'fc-password',params:{rootModel:$data,id:'primaryPasword',label:'Password:',dataPath: 'authPass',\n                        rootAttributes: {style:'max-width:10em'}}}\">\n                        </div>\n                    </div>\n                    <div class=\"oj-flex\">\n                        <div id=\"authReason\" class =\"oj-flex-item oj-sm-12 oj-md-6 oj-lg-6 oj-xl-6\" data-bind=\"component:\n                {name:'fc-select',params:{rootModel:$data,id:'authReason',label:'Reason:',dataPath: 'comment1',isDynamic: true,options: 'AuthReasons',manualDisable: disableComment1,\n                        rootAttributes: {style:'max-width:10em'}}}\">\n                        </div>\n                    </div>\n                    <div class=\"oj-flex\">\n                        <div id=\"comments\" class =\"oj-flex-item oj-sm-12 oj-md-6 oj-lg-6 oj-xl-6\" data-bind=\"component:\n                {name:'fc-input-text-area',params:{rootModel:$data,id:'comments',styleTextArea: 'width:25em;height:6em',defaultValue:'DEFAULT AUTHORIZATION',label:'Comments:',dataPath: 'comment2',\n                        manualDisable: disableComment2, rootAttributes: {style:'max-width:10em'}}}\">\n                        </div>\n                    </div>\n                    <!-- /ko -->\n                    <!-- ko if : remote()-->\n                    <oj-input-search\n                    data-bind=\"attr:{ id: 'Search', name:  'Search', placeholder:'Authorizer Search...' }\"\n                    raw-value=\"{{dataPath}}\"\n                    on-raw-value-changed=\"{{filterTable}}\"\n                    placeholder=\"Authorizer Search...\">\n                    </oj-input-search>\n                    \n                    <div class=\"oj-flex-item oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12\" id=\"grdAuthRemote\" data-bind=\"component: {name:'fc-datagrid',  \n                        params:{rootModel:$data, id: 'grdAuthRemote',editMode: 'cellEdit',width:'',datasource: grdAuthRemote,\n                        pageSize:4,onDoubleClick : onDoubleClickAuthoriser,CellClassName: 'oj-helper-justify-content-left' ,\n                        headerTemplate:'rowTemplateAuthRemote',cellTemplate:'cellTemplateAuthRemote',rootAttributes:{'style': 'width: 100%;height:150px;'}}}\"></div> \n                    <!-- /ko -->\n                    <script type=\"text/html\" id=\"rowTemplateAuthRemote\"> \n                        <!-- ko if: ($context.key == 'Id') -->  \n                        <span data-bind=\"text: 'User ID' \"></span>  \n                        <!-- /ko -->  \n                        <!-- ko if: ($context.key == 'UserName') -->  \n                        <span data-bind=\"text: 'User Name' \"></span>  \n                        <!-- /ko -->  \n                        <!-- ko if: ($context.key == 'LoggedIn') -->  \n                        <span data-bind=\"text: 'Logged In' \"></span>  \n                        <!-- /ko -->  \n                        </script>\n                        <script type=\"text/html\" id=\"cellTemplateAuthRemote\"> \n                            <!-- ko if: $context.keys.column == 'Id' || $context.keys.column == 'UserName' || $context.keys.column == 'LoggedIn' -->  \n                            <span data-bind=\"text: $context.data\"></span>  \n                            <!-- /ko -->  \n                            </script>\n                        </div>\n                     <!-- ko if : comments()-->  \n                     <div class=\"oj-flex\">\n                         <p class=\"oj-flex-item oj-sm-12 oj-md-6 oj-lg-6 oj-xl-6 fc-subheader\" data-bind=\"text: rbAuth.autCom\"></p>\n                     </div>\n                     <div class=\"oj-flex\">\n                         <div id=\"lblAuthComment1\" class=\"oj-flex-item oj-sm-12 oj-md-6 oj-lg-6 oj-xl-6\"  data-bind=\"component: {name:'fc-label', params:{rootModel:$data ,label:AuthComm1,id:'lblAuthComment1'}}\" ></div>\n                     </div> \n                     <div class=\"oj-flex\">\n                         <div id=\"lblAuthComment2\" class=\"oj-flex-item oj-sm-12 oj-md-6 oj-lg-6 oj-xl-6\"  data-bind=\"component: {name:'fc-label', params:{rootModel:$data ,label:AuthComm2,id:'lblAuthComment2'}}\" ></div>\n                     </div> \n                     <div class=\"oj-flex\">\n                         <p class=\"oj-flex-item oj-sm-12 oj-md-6 oj-lg-6 oj-xl-6 fc-subheader\" data-bind=\"text: rbAuth.autId\" ></p>\n                     </div>\n                     <div class=\"oj-flex\">\n                         <div id=\"lblAuthID\" class=\"oj-flex-item oj-sm-12 oj-md-6 oj-lg-6 oj-xl-6 fc-label\"  data-bind=\"component: {name:'fc-label', params:{rootModel:$data ,label:AuthId,id:'lblAuthID'}}\" ></div>\n                     </div>\n                     <!-- /ko -->\n                      <!-- ko if : central()-->  \n                     <div class=\"oj-dialog-footer\">\n                         <div id=\"lblInfo\" class=\"oj-flex-item oj-sm-12 oj-md-6 oj-lg-6 oj-xl-6\"  data-bind=\"visible: lblInfoVisible,component: {name:'fc-label', params:{rootModel:$data ,label:rbAuth.cliOnOkToSenForAut,id:'lblInfo'}}\" ></div>\n                   <div id=\"blank\" class=\"oj-flex-item oj-sm-12 oj-md-6 oj-lg-6 oj-xl-6\"  data-bind=\"visible: lblInfoVisible,component: {name:'fc-label', params:{rootModel:$data ,label:'     ',id:'blank'}}\" ></div>\n                            <div id=\"grantButton\" class=\"fc-button\" data-bind=\"component: {name:'fc-button', params:{rootModel:$data ,id:'grantButton',label:'OK', buttonClick:  CentralAuthOKClick,manualDisable: disableGrantButton}}\"></div> \n                          <div id=\"detailsButton\" class=\"fc-button\" data-bind=\"visible: detailsButtonVisible,component: {name:'fc-button', params:{rootModel:$data ,id:'detailsButton',label:detailsLabel, buttonClick:  detailsOnClick}}\"></div> \n                            <div id=\"cancelButton\" class=\"fc-button\" data-bind=\"visible: cancelButtonVisible,component: {name:'fc-button', params:{rootModel:$data ,id:'cancelButton',label:'Cancel', buttonClick:  cancelOnClick,manualDisable: disableCancelButton}}\"></div> \n                            <div id=\"comentsButton\" class=\"fc-button\" data-bind=\"component: {name:'fc-button', params:{rootModel:$data ,id:'comentsButton',label:'Comments',  manualDisable: false, buttonClick: showComments}}\"></div> \n                    </div>\n                    <!-- /ko -->  \n                     <!-- ko ifnot : central()--> \n                     <div class=\"oj-dialog-footer\">\n                      <div id=\"grantButton\" class=\"fc-button\" data-bind=\"component: {name:'fc-button', params:{rootModel:$data ,id:'grantButton',label:'Grant', buttonClick:  grantOnClick,manualDisable: disableGrantButton}}\"></div> \n                        <div id=\"denyButton\" class=\"fc-button\" data-bind=\"component: {name:'fc-button', params:{rootModel:$data ,id:'denyButton',label:'Deny', buttonClick:  denyOnClick, manualDisable: disabledenyButton}}\"></div> \n                          <div id=\"detailsButton\" class=\"fc-button\" data-bind=\"component: {name:'fc-button', params:{rootModel:$data ,id:'detailsButton',label:detailsLabel, buttonClick:  detailsOnClick}}\"></div> \n                            <div id=\"cancelButton\" class=\"fc-button\" data-bind=\"component: {name:'fc-button', params:{rootModel:$data ,id:'cancelButton',label:'Cancel', buttonClick:  cancelOnClick,manualDisable: disableCancelButton}}\"></div> \n                            </div>\n                          <!-- /ko -->  \n                    </oj-dialog>\n                </div>\n"
          },
