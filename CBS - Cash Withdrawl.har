            "text": "<div class=\"oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12 oj-flex-item\">\n    <oj-data-grid\n            data-bind=\"attr:{id: idTag, name: idTag}\"\n            data=\"[[datasource]]\"\n            selection-mode.row=\"multiple\"\n            header.column.style=\"[[widthStyle]]\"\n            header.column.resizable='{\"width\":\"enable\"}'\n            header.column.renderer=\"[[KnockoutTemplateUtils.getRenderer(headerTemplate)]]\"\n            cell.class-name=\"[[CellClassName]]\"\n            cell.renderer=\"[[cellTemplate]]\"\n            on-oj-before-edit=\"[[onRowDblClick]]\"\n            header.column.class-name=\"[[headerClassName]]\"\n            header.column.sortable=\"[[sorting]]\"\n            edit-mode=\"[[editMode]]\"\n            on-oj-before-edit-end=\"[[handleEditEnd]]\"\n            header.row.style=\"[[heightStyle]]\"\n            style=\"width: 100%;height:175px\">\n    </oj-data-grid>\n                            \n    <!-- ko if: PagingRequired() -->\n    <oj-paging-control\n            data-bind=\"attr:{id: idTag + 'paging', name: idTag + 'paging'}\"\n              data=\"[[datasource]]\"\n              page-size=\"{{pageSize}}\"\n            class=\"oj-sm-padding-1x-top\">\n    </oj-paging-control>\n    <!-- /ko -->\n  \n    <oj-popup id=\"popUp1\" tail=\"simple\" style=\"display:none; overflow:hidden;\">\n    <span class=\"custom_tooltip fcr-left-align\" ></span>\n    </oj-popup>\n</div>\n"
