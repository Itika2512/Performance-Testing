            "text": "<!-- ko if : $component.displayScreen-->  \r\n  <div id=\"buttonBarTransactioDefinition\" class=\"oj-header-border\" data-bind=\"visible: showButtonBar,component: {name:'button-bar-transaction-definition', params:{rootModel:$data,tabIndex:'1',title: rbMenu['7116'],tdefokButtonDisable:disableOkBtn, clearButtonRequired: clearButtonReqd, closeButtonRequired:closeButtonReqd}}\"></div>  \r\n  <div id=\"mainContent\" role=\"main\" class=\"oj-flex oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12 oj-padding-top oj-panel\" style=\"height:70.5vh;overflow:auto\"> \r\n    <div id=\"mainScreen\" class=\"oj-flex-item oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12\"> \r\n    <div class=\"oj-flex \">\r\n\t<div class=\"oj-flex-item oj-sm-12 oj-md-6 oj-lg-6 oj-xl-6\">\r\n\r\n            <div class=\"oj-flex\">\r\n                 <div id=\"accountNo\" class=\"oj-flex-item oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12\" data-bind=\"component: {name:'account-no', params:{rootModel:$data,tabIndex:'2',id:'AccountNo',isKeyField:true, label:rb7116.acctNo, isRequired: true, onChange: acctNoOnchange,dataPath: 'BropAccountNumber', manualDisable:disableAccountNo,lockedat:[], rootAttributes: {style:'max-width:10em'}}}\"> \r\n                    <div id=\"acctTitle\" class=\"fc-inline-comp\" data-bind=\"component: {name:'customer-name', params:{rootModel:$data,tabIndex:'3',id:'AcctTitle',isKeyField:false,manualDisable:true, label:'', isRequired: false,dataPath: 'AccountTitle', lockedat:[], rootAttributes: {style:'max-width:24em;width:24em;'}}}\"></div> \r\n                 </div> \r\n            </div> \r\n            <div class=\"oj-flex\">\r\n                <div id=\"branchCode\" class=\"oj-flex-item oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12\" data-bind=\"component: {name:'branch-code', params:{rootModel:$data,tabIndex:'4',id:'BranchCode',isKeyField:false, manualDisable:true,label:rb7116.branCod, isRequired: false,dataPath: 'BranchCode7116',disabled :true, lockedat:[], serverValidation:'validateBranch', rootAttributes: {style:'max-width:5em'}}}\"> \r\n                    <div id=\"lovBranchCode\" class=\"fc-list-btnLov\" data-bind=\"component: {name:'fc-list-of-values', params:{rootModel:$data,tabIndex:'5', execute: 'execute',queryId:  'GETBRNCODE' ,columnNames: ['BRANCHCODE','BRANCHNAME'], rowKeyValue:['BRANCHCODE'], taskCode:'7116',outputParam: [['BRANCHCODE'],['BRANCHNAME']],inputParam: [['BranchCode7116']],id:'lovBranchCode',columnTexts:rb7116.lovDtlsBr, manualDisable:true,required: false,lockedat:[], rootAttributes: {style:'max-width: 10em;width:10em'}}}\"></div>  \r\n                    <div id=\"branchName\" class=\"fc-inline-comp \" data-bind=\"component: {name:'fc-string', params:{rootModel:$data,tabIndex:'6',id:'BranchName',isKeyField:false,disabled :true,manualDisable:true,dataPath:'BranchName7116', isRequired: false, lockedat:[],maxLength:120, rootAttributes: {style:'max-width:24em;width:23.6em;'}}}\"></div> \r\n                </div>\r\n            </div>\r\n            <div class=\"oj-flex\">\r\n                <div id=\"statusType\" class=\"oj-flex-item oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12\" data-bind=\"component: {name:'fc-select',  params:{rootModel:$data,tabIndex:'7',id:'StatusType',isKeyField:false,manualDisable:true, label:rb7116.acctStats, isRequired: false,options:'ctlAuthAcctStat', dataPath: 'StatusType7116', lockedat:[] , isDynamic:false,rootAttributes: {style:'max-width: 7em'}}}\"></div> \r\n            </div>\r\n            <div class=\"oj-flex\">\r\n                <div id=\"currencyShortName\" class=\"oj-flex-item oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12\" data-bind=\"component: {name:'fc-string', params:{rootModel:$data,tabIndex:'8',id:'CurrencyShortName',isKeyField:false,manualDisable:true, label:rb7116.cur,dataPath:'CurrencyShortName7116', isRequired: false, lockedat:[],rootAttributes: {style:'max-width: 7em'}}}\"></div> \r\n            </div>\r\n            <div class=\"oj-flex\">\r\n                <div id=\"amount\" class=\"oj-flex-item oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12\" data-bind=\"component: {name:'positive-amount', params:{rootModel:$data,tabIndex:'9',id:'Amount',isKeyField:false, label:rb7116.amt, isRequired: true,dataPath: 'Amount', onChange:onAmountOnChange,lockedat:[],manualDisable:disableAmount ,rootAttributes: {style:'max-width: 10em'}}}\"></div> \r\n            </div>\r\n             <div class=\"oj-flex-item oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12\">\r\n\t\t   <p data-bind=\"text:rb7116.ins\" class=\"fc-subheader\"></p> \r\n            </div>\r\n            <div class=\"oj-flex oj-sm-12 oj-md-6 oj-lg-6 oj-xl-12\">\r\n                <div id=\"opInstructions\" class=\"oj-flex-item oj-sm-12 oj-md-6 oj-lg-6 oj-xl-12\" data-bind=\"component: {name:'fc-input-text-area', params:{rootModel:$data,tabIndex:'10',id:'OpInstructions', isRequired: false, dataPath:'OperatingInstruction',manualDisable:true,lockedat:[],disabled:true,styleTextArea: 'max-width:550px;height:65px', rootAttributes: {}}}\"></div>\r\n            </div>\r\n        </div>\r\n        <div class=\"oj-flex-item oj-sm-12 oj-md-6 oj-lg-6 oj-xl-6\">\r\n           \r\n            <div class=\"oj-flex-item oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12\">\r\n\t\t\t<p data-bind=\"text:'Instrument Image Display'\" class=\"fc-subheader\"></p>\r\n\t\t\t<div class=\"oj-flex oj-sm-12 oj-md-6 oj-lg-6 oj-xl-12\">\r\n\t\t\t\t<div id=\"divImgToolbar\" class=\"oj-flex-item oj-sm-12 oj-md-6 oj-lg-6 oj-xl-6\" data-bind=\"component:{ name:'fc-imgtoolbar', id:'ImgToolBar', rootAttributes:{style:'max-width: 10em color:white;'}, params:{rootModel:$data,tabIndex:'11',id:'custImage', manualDisable: false}}\"></div>\r\n\t\t\t \t<div class=\"oj-flex-item oj-sm-12 oj-md-6 oj-lg-6 oj-xl-6\">\r\n\t\t\t\t\t<div id=\"btnVerify1\" class=\"fc-inline-comp\"  data-bind=\"component: {name:'fc-button', params:{rootModel:$data,tabIndex:'12',id:'btnVerify1',  isRequired: false,manualDisable:false,label:'Front Image',buttonClick :btnVerify2Click,lockedat:[], rootAttributes: {style:'width: 3em'}}}\"></div> \r\n\t\t\t\t\t<div id=\"btnVerify2\" class=\"fc-inline-comp\"  data-bind=\"component: {name:'fc-button', params:{rootModel:$data,tabIndex:'13',id:'btnVerify2',  isRequired: false,manualDisable:false,label:'Reverse Image',buttonClick :btnVerify2Click,lockedat:[], rootAttributes: {style:'width: 3em'}}}\"></div> \r\n\t\t\t\t\t<div id=\"btnVerify3\" class=\"fc-inline-comp\"  data-bind=\"component: {name:'fc-button', params:{rootModel:$data,tabIndex:'14',id:'btnVerify3',  isRequired: false,manualDisable:false,label:'Gray Image',buttonClick :btnVerify2Click,lockedat:[], rootAttributes: {style:'width: 3em'}}}\"></div> \r\n                \t\t</div>\r\n\t\t\t</div>\r\n\t\t\t<div class=\"oj-flex oj-sm-12 oj-md-6 oj-lg-6 oj-xl-12\">\r\n\t\t\t\t<div id=\"divCustomerImage\" class=\"oj-flex-item oj-panel oj-panel-alt2 oj-sm-margin-1x custom-showDiv \" style=\"height:150px; overflow:auto\"> \r\n\t\t\t\t\t<img style=\"border-radius: 5px; cursor: pointer; transition: 0.3s; width: 450px; height : 133px;\" data-bind=\"attr:{'src': $component.CustomerImage(),'title': '', id:screenMnemonic+'custImage'}, click: onChangeInstrument\"></img> \r\n\t\t\t\t</div> \r\n\t\t\t</div>\r\n            </div>\t  \r\n\t</div>\r\n    </div>                                \r\n\t<div class=\"oj-flex\">\r\n      <div class=\"oj-flex-item oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12\" data-bind=\"attr:{ id: screenMnemonic + 'tabs-container'}, component:{ name: 'fc-tabs', params:{rootModel:$data, disabledTabs: disabledTabs, selectedTab: selectedTab,id: 'tabOpInsCustDtlsDisplay',tabItems: [{ tabLabel: rb7116.tab0, tabTemplate: tabTemplateIdList7116[0], tabId: tabIdList7116[0]},{ tabLabel: rb7116.tab1, tabTemplate: tabTemplateIdList7116[1], tabId: tabIdList7116[1]},{tabLabel: rb7116.tab2, tabTemplate: tabTemplateIdList7116[2], tabId: tabIdList7116[2]}]}}\"></div>  \r\n      <script type=\"text/html\" data-bind=\"attr: {id: tabTemplateIdList7116[0]}\"> \r\n        <div class=\"oj-sm-12 oj-md-12 oj-lg-12 oj-xl-12 oj-header-border oj-padding-top oj-panel\"> \r\n          <div class=\"oj-flex\"> \r\n            <div class=\"oj-flex-item\"> \r\n              <p data-bind=\"text:rb7116.amtOpInstr\" class=\"fc-subheader\"></p>  \r\n              <div class=\"oj-flex-item oj-sm-12 oj-md-11 oj-lg-11 oj-xl-11\" id=\"OpInstructionDtls\" data-bind=\"component: {name:'fc-datagrid',params:{rootModel:$data,tabId:tabIdList7116[0],tabIndex:'15', id: 'grdInstructionDtls',editMode:instrDtlEditMode,width:opInstrWidthStyle,pageSize:'20',datasource: grdInstructionDtlsDatasource,onDoubleClick:onDoubleClickGrdInstructionDtls,CellClassName: getCellClassName ,headerTemplate:'7116_GrdInstrDtls_header_template',cellTemplate:'7116_GrdInstrDtls_cellTemplate'}}\"></div> \r\n            </div>  \r\n            <div id=\"grpSignatureDiv\" class=\"oj-sm-12 oj-md-4 oj-lg-4 oj-xl-4\"> \r\n              <p id=\"grpSignReqHdr\" data-bind=\"text:rb7116.grpSignReq\" class=\"fc-subheader\"></p>  \r\n              <div id=\"GrpSignature\" data-bind=\"component: {name:'fc-datagrid',params:{rootModel:$data,tabIndex:'16',tabId:tabIdList7116[0],id: 'grdGroupSignature',editMode:grpSignEditMode,width:grpSignWidthStyle,pageSize:'20',datasource: grdGroupSignatureDatasource,CellClassName: getCellClassName ,headerTemplate:'7116_GrdGrpSign_header_template',cellTemplate:'7116_GrdGrpSign_cellTemplate'}}\"></div> \r\n            </div> \r\n          </div>  \r\n          <div class=\"oj-flex\"> \r\n            <div class=\"oj-flex-item oj-sm-12 oj-md-6 oj-lg-6 oj-xl-6\"> \r\n              <p data-bind=\"text:rb7116.amtOpImageDisplay\" class=\"fc-subheader\"></p>  \r\n              <div class=\"oj-flex-item oj-sm-12 oj-md-11 oj-lg-11 oj-xl-11\" id=\"AmtOpImgDisplay\" data-bind=\"component: {name:'fc-datagrid',params:{rootModel:$data,tabId:tabIdList7116[0],tabIndex:'17', id: 'grdImageDisplay',editMode:imgDispEditMode,width:imgDispWidthStyle,pageSize:'20',datasource: grdImageDisplayDatasource,onDoubleClick:onDoubleClick