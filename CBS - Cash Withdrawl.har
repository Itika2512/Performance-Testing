            "text": "<!--ko if:lovLabel -->\r\n<oj-button\r\n        data-bind=\"attr:{ id: 'btnLOV', style: lovWidth},event : {blur : blankValidation ,focus : onFocus}\" on-oj-action=\"{{buttonLOV}}\" visible=\"{{buttonLovVisible}}\" disabled=\"{{keyField}}\">\r\n    <span data-bind=\"text:lovLabel\"></span>\r\n</oj-button>\r\n<!-- /ko -->\r\n<!--ko ifnot:lovLabel -->\r\n<oj-button class='fc-lov'\r\n           data-bind=\"attr:{ id: idTag,name :idTag, style: lovWidth},event : {blur : blankValidation ,focus : onFocus}\" on-oj-action=\"{{buttonLOV}}\"\r\n           display =\"icons\" visible=\"{{buttonLovVisible}}\" disabled=\"{{keyField}}\">\r\n    <span slot='startIcon' class=\"demo-search-button oj-fwk-icon-magnifier oj-fwk-icon oj-clickable-icon-nocontext\"></span>\r\n</oj-button>\r\n<!-- /ko -->\r\n<div>\r\n    <oj-dialog data-bind=\"attr:{ id: idTag + 'LovModalDialog' }\" initialVisibility=\"hide\" resizeBehavior=\"none\" dialog-title=\"\" rootAttributes=\"{{attributes}}\" style=\"min-width: 700px; max-width:1000px\";\r\n              class=\"custom_popup\">\r\n        <div slot=\"header\" class=\"oj-dialog-header oj-helper-clearfix fc-dialog\">\r\n            <span  class=\"oj-dialog-title\"> Oracle FLEXCUBE Data Selection </span>\r\n        </div>\r\n        <div class=\"oj-dialog-body\">\r\n            <div class=\"oj-flex\">\r\n\r\n                <oj-input-text\r\n                        data-bind=\"attr:{id: idTag + 'Search', name: idTag + 'Search'}\"\r\n                        placeholder=\"Search Text\"\r\n                        required =false\r\n                        disabled = false\r\n                        autofocus = true\r\n                        on-raw-value-changed=\"{{filterTable}}\"\r\n                        rootAttributes=\"{{attributes}}\"\r\n                        value= \"{{searchString}}\">\r\n                </oj-input-text>\r\n\r\n            </div>\r\n            <div class=\"oj-flex\">\r\n                <oj-table summary=\"Picklist Data\" aria-label=\"Picklist Data\"\r\n                          data-bind=\"attr:{ id: idTag + 'TableLOV' }\"\r\n                          data=\"{{datasource}}\"\r\n                          selection-mode='{\"row\": \"single\"}'\r\n                          on-selection-changed='{{selectionListener}}'\r\n                          columns-default='{\"sortable\": \"enabled\"}'\r\n                          columns= \"{{columnNames}}\"\r\n                          style='width: 300%; height: 300px;'>\r\n                    <oj-paging-control id=\"paging\" data='[[datasource]]' page-size=25 slot='bottom'>\r\n                    </oj-paging-control>\r\n                </oj-table>\r\n            </div>\r\n        </div>\r\n    </oj-dialog>\r\n</div>\r\n<!--ko if:lovPopup -->\r\n<oj-dialog data-bind=\"attr:{ id: idTag + 'LovModalDialogPopup' }\" initialVisibility=\"hide\" resizeBehavior=\"none\" dialog-title=\"\" rootAttributes=\"{{attributes}}\"\r\n              style=\"min-width: 700px; max-width:1000px\"; class=\"custom_popup\">\r\n    <div slot=\"header\" class=\"oj-dialog-header oj-helper-clearfix fc-dialog\">\r\n        <span  class=\"oj-dialog-title\"> Oracle FLEXCUBE Data Selection </span>\r\n    </div>\r\n    <div class=\"oj-dialog-body\">\r\n        <div class=\"oj-flex\">\r\n\r\n            <oj-input-text\r\n                    data-bind=\"attr:{id: idTag + 'Search', name: idTag + 'Search'}\"\r\n                    placeholder=\"Search Text\"\r\n                    required =false\r\n                    disabled =false\r\n                    on-raw-value-changed=\"{{filterTable}}\"\r\n                    rootAttributes=\"{{attributes}}\"\r\n                    value= \"{{searchString}}\">\r\n            </oj-input-text>\r\n\r\n        </div>\r\n        <div class=\"oj-flex\">\r\n            <oj-table summary=\"Picklist Data\" aria-label=\"Picklist Data\"\r\n                      data-bind=\"attr:{ id: idTag + 'TableLOVPopup' }\"\r\n                      data=\"{{datasource}}\"\r\n                      selection-mode='{\"row\": \"single\"}'\r\n                      on-selection-changed=\"{{selectionListener}}\"\r\n                      columns-default='{\"sortable\": \"enabled\"}'\r\n                      columns= \"{{columnNames}}\"\r\n                      style='width: 100%; height: 300px;'>\r\n                <oj-paging-control id=\"paging\" data='[[datasource]]' page-size='25' slot='bottom'>\r\n                </oj-paging-control>\r\n            </oj-table>\r\n        </div>\r\n\r\n    </div>\r\n</oj-dialog>\r\n<!-- /ko -->"
